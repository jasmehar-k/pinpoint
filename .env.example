# Copy to .env and fill in. Never commit .env.

# seeded = no network calls to Slack or Nango (demo fallback); live = use real Slack
PINPOINT_MODE=seeded

# Supabase Postgres + pgvector. Use the SESSION POOLER string, not the direct one.
DATABASE_URL=

# GitHub personal access token (read-only public repo access is enough)
GITHUB_TOKEN=

# Slack bot token (xoxb-...). Bot must be invited to each public channel it reads.
SLACK_BOT_TOKEN=

# Nango (optional; raw tokens above are the fallback)
NANGO_SECRET_KEY=

# LLM via OpenRouter (OpenAI-compatible). Use a free model that supports tool calling.
OPENROUTER_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Embeddings run locally with fastembed; no key needed.

# Frontend: 1 = read /fixtures JSON instead of the backend
NEXT_PUBLIC_USE_FIXTURES=1
NEXT_PUBLIC_API_URL=http://localhost:8000
